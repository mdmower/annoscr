<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-annoscr">
    <comment>Annoscr annotation document</comment>
    <!-- The file is a chunk container (image + editable annotations). -->
    <glob pattern="*.annoscr"/>
    <!-- Fallback when the extension is wrong: the container magic. -->
    <magic priority="80">
      <match type="string" value="ANNOSCR\x1A" offset="0"/>
    </magic>
    <!-- Documents written before the container are a JSON envelope whose format
         marker appears near the start. -->
    <magic priority="60">
      <match type="string" value="annoscr-document" offset="0:256"/>
    </magic>
    <!-- A .annoscr is fundamentally an image plus editable annotations. -->
    <generic-icon name="image-x-generic"/>
  </mime-type>
</mime-info>
